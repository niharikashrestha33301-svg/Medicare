PORT=5000
NODE_ENV=development
# Generated locally by npm run setup:database. Never use a shared example secret.
JWT_SECRET=
APP_TIMEZONE=Asia/Kathmandu
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5000,http://127.0.0.1:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=medicare_db
DB_PORT=3306

# Optional live AI; leave empty for the clearly labelled guided navigator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set by: node scripts/setup-assistant.js. Keep this stable and private.
ASSISTANT_ENCRYPTION_KEY=

# Optional medicine-reminder delivery. Generate VAPID keys with npm run setup:medicine.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
APP_PUBLIC_URL=http://localhost:5000
MEDICINE_WORKER_ENABLED=true
# Email remains unavailable until an SMTP service is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Video calls: authenticated, short-lived coturn REST credentials; never expose this secret.
# Match the timezone used by the clinic's existing appointment slots.
APPOINTMENT_TIMEZONE=Asia/Kolkata
# Used only when no private TURN relay is configured. Set empty to disable public STUN.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=
# Keep mysql until the separate MediCare project is created and connection tested.
VIDEO_STORE=mysql
SUPABASE_PROJECT_REF=
# Direct or session-pooler PostgreSQL URL from the new project's Connect dialog.
# Server only. Never put the database password in frontend/VITE variables.
SUPABASE_DB_URL=
# Optional trusted database CA certificate, base64 encoded; TLS is always verified.
SUPABASE_DB_CA_BASE64=
# Enable ordering only after the actual pharmacy inventory and fulfillment are configured.
PHARMACY_ENABLED=false
PHARMACY_COD_ENABLED=false
# Comma-separated admin user IDs belonging to authorized pharmacist reviewers.
PHARMACY_REVIEWER_IDS=
# Optional Razorpay integration; configure a signed payment.captured webhook as documented.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Separate MediCare native Auth (prepared; existing login remains active)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Pharmacy authorization is an operator attestation, not automatic regulatory approval.
# Set only after verifying the operator's actual pharmacy licence and fulfillment readiness.
PHARMACY_AUTHORIZED=false
PHARMACY_LICENSE_REFERENCE=

# Local development only. Demo inventory cannot be used for real checkout.
PHARMACY_DEMO_ENABLED=false
